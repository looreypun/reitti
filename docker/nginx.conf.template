# Rendered at container start by the nginx image (envsubst). ${VARS} come from the environment.
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    resolver ${NGINX_RESOLVER} valid=30s ipv6=off;

    # Ollama API, proxied so the browser stays on the same origin.
    location /ollama/ {
        set $ollama_upstream ${OLLAMA_URL};
        rewrite ^/ollama/(.*)$ /$1 break;
        proxy_pass $ollama_upstream;

        proxy_http_version 1.1;
        proxy_set_header Connection "";
        # Ollama rejects unknown browser origins; drop the header since this is server-to-server.
        proxy_set_header Origin "";
        proxy_set_header Authorization "${OLLAMA_AUTH_HEADER}";
        proxy_ssl_server_name on;

        # Stream tokens as they arrive; allow slow first responses while a model loads.
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        client_max_body_size 10m;
    }

    location = /config.js {
        add_header Cache-Control "no-store";
    }

    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Client-side routes fall back to the app.
    location / {
        try_files $uri $uri/ /index.html;
    }

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
}
