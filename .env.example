# Copy to .env.local and adjust. Restart the dev server after changes.

# Ollama server used by the Ask AI panel
VITE_OLLAMA_URL=http://localhost:11434

# Chat model used by Ask Reitti AI (must be installed: ollama pull <model>).
# Leave empty to use the first installed chat model.
VITE_OLLAMA_MODEL=granite4.2:3b
